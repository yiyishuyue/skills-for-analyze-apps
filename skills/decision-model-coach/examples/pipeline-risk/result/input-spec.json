{
  "meta": {
    "title": "真实工程案例：管道铺设施工风险应对",
    "decision_goal": "在公开模型及可行性假设下最小化预期增量成本",
    "metric": "应对费用加预期延期机会损失与超支",
    "unit": "百万美元",
    "horizon": "本工作包的增量决策；机会损失按月计",
    "higher_is_better": false
  },
  "variables": [
    {
      "id": "response_cost",
      "label": "应对费用",
      "base": 0,
      "kind": "fixed",
      "domain": [
        0,
        56
      ],
      "source": "Dey (2001), Table VI: https://www.researchgate.net/publication/40499031_Decision_support_system_for_risk_management_a_case_study",
      "source_class": "industry_ref"
    },
    {
      "id": "delay",
      "label": "失败时延期月数",
      "base": 0,
      "kind": "fixed",
      "domain": [
        0,
        12
      ],
      "source": "Dey (2001), Table VI: https://www.researchgate.net/publication/40499031_Decision_support_system_for_risk_management_a_case_study",
      "source_class": "industry_ref"
    },
    {
      "id": "overrun",
      "label": "失败时直接超支",
      "base": 0,
      "kind": "fixed",
      "domain": [
        0,
        22
      ],
      "source": "Dey (2001), Table VI: https://www.researchgate.net/publication/40499031_Decision_support_system_for_risk_management_a_case_study",
      "source_class": "industry_ref"
    },
    {
      "id": "monthly_value",
      "label": "每延期一月的机会损失",
      "base": 7.5,
      "kind": "fixed",
      "domain": [
        0,
        7.5
      ],
      "source": "Dey (2001), Table VI: https://www.researchgate.net/publication/40499031_Decision_support_system_for_risk_management_a_case_study",
      "source_class": "industry_ref",
      "scan": {
        "low": 0,
        "high": 7.5,
        "source": "Analyst-added structural stress test from zero-loss boundary to published baseline, not a forecast interval"
      }
    }
  ],
